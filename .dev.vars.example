# Copy to .dev.vars for `npm run dev`. Talks to api.plivo.com directly with Basic auth_id:auth_token,
# because the auth proxy cannot mint SMS/call/number stk_ tokens yet.
PLIVO_API_BASE=https://api.plivo.com
ALLOW_BASIC_AUTH=true
CONFIRMATION_MODE=confirm
# Any random string of 32+ characters, e.g. from `openssl rand -base64 48`.
CONFIRM_SECRET=
# OAuth sign-in against a local auth proxy: set all three, or leave PLIVO_LOGIN_BASE empty to keep it off.
# MCP_CLIENT_SECRET must equal the auth proxy's mcp_client_secret.
PLIVO_LOGIN_BASE=
OAUTH_SECRET=
MCP_CLIENT_SECRET=
