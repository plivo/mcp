{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plivo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // The dev auth proxy, for the first end-to-end test. Point both at the production one before launch.
    "PLIVO_API_BASE": "https://dev-global-auth-api.contactodev.com/v1/proxy",
    "PLIVO_LOGIN_BASE": "https://dev-global-auth-api.contactodev.com",
    "ALLOWED_HOSTS": "plivo-mcp.plivops.workers.dev",
    "ALLOW_BASIC_AUTH": "false",
    "CONFIRMATION_MODE": "confirm"
  }
  // CONFIRM_SECRET and OAUTH_SECRET are secrets, not vars: `wrangler secret put <NAME>`, at least 32 characters each.
}
