{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plivo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // The dev auth proxy, for the first end-to-end test. Point both at the production one before launch.
    "PLIVO_API_BASE": "https://dev-global-auth-api.contactodev.com/v1/proxy",
    "PLIVO_LOGIN_BASE": "https://dev-global-auth-api.contactodev.com",
    "ALLOW_BASIC_AUTH": "false",
    "CONFIRMATION_MODE": "confirm"
  }
  // Secrets, not vars (`wrangler secret put <NAME>`): CONFIRM_SECRET, OAUTH_SECRET and MCP_CLIENT_SECRET (the auth
  // proxy's mcp_client_secret), at least 32 characters each,
  // and ALLOWED_HOSTS (the Host values the Worker accepts) and PUBLIC_ORIGIN (the origin clients use when a proxy
  // forwards the Worker's own Host), kept out of this public repo until launch.
}
